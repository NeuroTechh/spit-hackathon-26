# ═══════════════════════════════════════════════════════════
# RacePass Backend — .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────
node_modules/
package-lock.json

# ─── Build Output ─────────────────────────────────────────
dist/
build/
*.js.map
*.d.ts
!hardhat.config.ts

# ─── Environment & Secrets ────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.cert

# ─── Hardhat / Blockchain ────────────────────────────────
cache/
artifacts/
typechain-types/
deployments/
*.abi

# ─── Database ─────────────────────────────────────────────
*.sql.bak
*.dump
*.sqlite
*.sqlite3

# ─── Docker Volumes ───────────────────────────────────────
docker/postgres_data/
docker/redis_data/
docker-data/

# ─── Logs ─────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# ─── Testing & Coverage ──────────────────────────────────
coverage/
coverage.json
.nyc_output/
test-results/
junit.xml

# ─── IDE & Editors ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Misc ─────────────────────────────────────────────────
.cache/
tmp/
temp/
*.tgz
*.tar.gz
.npmrc
