# ═══════════════════════════════════════════════════════════
# RacePass Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://racepass:racepass_secret@localhost:5432/racepass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=racepass
DB_USER=racepass
DB_PASSWORD=racepass_secret
DB_SSL=false

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Blockchain ──────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Contract Addresses (set after deployment) ───────────
CREDENTIAL_REGISTRY_ADDRESS=
EVENT_PASS_NFT_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=

# ─── Reclaim Protocol ────────────────────────────────────
RECLAIM_APP_ID=your-reclaim-app-id
RECLAIM_APP_SECRET=your-reclaim-app-secret
RECLAIM_PROVIDER_ID_AGE=your-age-provider-id
RECLAIM_PROVIDER_ID_KYC=your-kyc-provider-id

# ─── IPFS ─────────────────────────────────────────────────
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=

# ─── Security ─────────────────────────────────────────────
SERVER_PEPPER=change-this-to-a-random-64-char-hex-string
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
