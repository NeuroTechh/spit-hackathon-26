# ═══════════════════════════════════════════════════════════
# RacePass Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://racepass:racepass_secret@localhost:5432/racepass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=racepass
DB_USER=racepass
DB_PASSWORD=racepass_secret
DB_SSL=false

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Better-Auth ─────────────────────────────────────────
BETTER_AUTH_SECRET=your-better-auth-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001

# ─── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="RacePass <noreply@yourdomain.com>"

# ─── Blockchain ──────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Contract Addresses (set after deployment) ───────────
CREDENTIAL_REGISTRY_ADDRESS=
EVENT_PASS_NFT_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=

# ─── Attestation Service ────────────────────────────────
ATTESTATION_SERVICE_URL=http://localhost:3002
ATTESTATION_SERVICE_API_KEY=dev-api-key-change-in-production

# ─── IPFS ─────────────────────────────────────────────────
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=

# ─── Security ─────────────────────────────────────────────
SERVER_PEPPER=change-this-to-a-random-64-char-hex-string
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
